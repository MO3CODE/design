# ── السيرفر ──
PORT=8787
# كلمة مرور الدخول للموقع (اتركها فاضية للتشغيل المحلي فقط)
APP_PASSWORD=
SESSION_SECRET=غيّرها-لنص-عشوائي-طويل
# DATA_DIR=./data

# ── الذكاء الاصطناعي: RadoxAI (متوافق مع OpenAI) ──
AI_PROVIDER=radox
RADOX_API_KEY=
RADOX_BASE_URL=https://radoxai.com/v1

# أو Anthropic مباشرة (AI_PROVIDER=anthropic) — يكاش التعليمات الثابتة
ANTHROPIC_API_KEY=

# ── توليد العناصر والصور: GPT Image عبر OpenAI مباشرة (RadoxAI ما يدعم توليد الصور) ──
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# gpt-image-2.5-flare (سريع) · gpt-image-2.5-sunburst (أدق) · gpt-image-2
IMAGE_MODEL=gpt-image-2.5-flare
IMAGE_QUALITY=high

# ── التوجيه الذكي بين الموديلات ──
# smart (موصى) · economy · quality
AI_ROUTING=smart
# فاضي = اختيار تلقائي من قائمة موديلات المنصة (GET /v1/models)
MODEL_PRO=
MODEL_BALANCED=
MODEL_FAST=
MODEL_VISION=
# جولات الفحص البصري بعد التصميم (0 = بدون)
AI_REVIEW_ROUNDS=1
# إصلاح أخطاء الفحص الآلي تلقائياً (0 = متوقف)
AI_AUTOFIX=1
# 1 = يرسل كود المحرك كامل مع طلبات التصميم الجديد (أدق، ≈ 40 ألف توكن إضافية)
AI_INCLUDE_ENGINE_SOURCE=0
AI_MONTHLY_BUDGET=0

# ── الرسم والصور ──
# مسار كروم/إيدج لو ما انكشف تلقائياً
CHROME_PATH=
# بايثون اللي فيه rembg (لقص الخلفية تلقائياً — اختياري)
PYTHON_BIN=
# دقة الإخراج النهائي (3 = 3240×4050 للمنشور)
EXPORT_SCALE=3
MAX_PHOTO_SIDE=3400
# مجلد الخطوط التجارية (Expo Arabic / Bahij) لو مو داخل engine/assets/fonts
FONTS_DIR=
