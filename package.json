{
  "name": "investor-gate-design-studio",
  "version": "1.0.0",
  "private": true,
  "description": "استوديو تصاميم بوابة المستثمر — ارفع خطة المحتوى ويصمم بنفس محرك المهارة",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,web -c yellow,cyan \"tsx watch server/index.ts\" \"vite\"",
    "build": "vite build",
    "start": "tsx server/index.ts",
    "typecheck": "tsc --noEmit -p .",
    "build:vercel": "vite build && node scripts/copy-engine.mjs"
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@sparticuz/chromium": "^153.0.0",
    "@vercel/blob": "^2.8.2",
    "@vercel/functions": "^3.10.1",
    "archiver": "^8.0.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.7",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "multer": "^2.4.0",
    "puppeteer-core": "^25.13.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "concurrently": "^10.0.6",
    "lucide-react": "^1.57.0",
    "postcss": "^8.5.30",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^3.4.19",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}